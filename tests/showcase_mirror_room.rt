# Mirror Room - Reflective surfaces and spheres
A 0.15 255,255,255

C 0,5,15 0,-0.2,-1 70
L 0,12,5 0.9 255,255,255

# Central glass-like sphere (cyan)
sp 0,2,0 2.5 100,200,255

# Red metallic sphere
